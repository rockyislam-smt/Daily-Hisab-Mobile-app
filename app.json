{
  "expo": {
    "name": "PocketFlow",
    "slug": "pocketflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pocketflow.finance",
      "infoPlist": {
        "NSFaceIDUsageDescription": "PocketFlow uses biometric authentication to secure your financial records offline."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D3B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.pocketflow.finance",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D3B2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PocketFlow to use biometric verification to access your offline financial records."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
